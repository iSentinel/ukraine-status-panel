#include <cassert>
#include <cstdint>
#include <cstdio>
#include "usp_alert_region_colors.h"
inline uint32_t old_full_color(int state, uint8_t palette) {
  state = static_cast<uint8_t>(state);
  uint32_t color = 0x34424E;
  if (state == 1) color = 0x1F8A4C;
  else if (state == 2 || state == 8) color = 0xF5BE26;
  else if (state == 16) color = 0xF97316;
  else if (state == 4) color = 0xDC3545;
  else if (state == 32) color = 0x9C27B0;
  else if (state == 64) color = 0xA855F7;
  else if (state == 128) color = 0xF97316;
  return usp_alert_palette::color_hex(color, palette);
}

uint32_t old_yaml_color0(uint8_t state, uint8_t palette) {
uint32_t color = 0x34424E;
if (state == 1U) color = 0x1F8A4C;
else if (state == 2U || state == 8U)
  color = 0xF5BE26;
else if (state == 16U) color = 0xF97316;
else if (state == 4U) color = 0xDC3545;
else if (state == 32U) color = 0x9C27B0;
else if (state == 64U) color = 0xA855F7;
else if (state == 128U) color = 0xF97316;
color = usp_alert_palette::color_hex(
    color, palette);
return color;
}

uint32_t old_yaml_color1(uint8_t state, uint8_t palette) {
uint32_t color = 0x34424E;
if (state == 1U) color = 0x1F8A4C;
else if (state == 2U || state == 8U) color = 0xF5BE26;
else if (state == 16U) color = 0xF97316;
else if (state == 4U) color = 0xDC3545;
else if (state == 32U) color = 0x9C27B0;
else if (state == 64U) color = 0xA855F7;
else if (state == 128U) color = 0xF97316;
color = usp_alert_palette::color_hex(color, palette);
return color;
}

int main() {
  unsigned comparisons = 0;
  for (int state = -1024; state < 1024; ++state) {
    for (unsigned mode = 0; mode < 256; ++mode) {
      const auto palette = static_cast<uint8_t>(mode);
      const auto actual = usp_alert_region_colors::color_hex(state, palette);
      assert(actual == old_full_color(state, palette));
      assert(actual == old_yaml_color0(static_cast<uint8_t>(state), palette));
      assert(actual == old_yaml_color1(static_cast<uint8_t>(state), palette));
      comparisons += 3;
    }
  }
  assert(usp_alert_region_colors::color_hex(64, 0) == 0xA855F7);
  std::printf("MAP_COLOR_COMPARISONS=%u\n", comparisons);
}
