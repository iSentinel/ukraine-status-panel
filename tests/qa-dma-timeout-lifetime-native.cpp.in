#include <cassert>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <string>
#include <vector>
#define USE_ESP32 1
#define SOC_AHB_GDMA_SUPPORTED 1
#define SOC_AHB_GDMA_SUPPORT_PSRAM 1
#define IRAM_ATTR
#define YESNO(value) ((value) ? "YES" : "NO")
#define pdMS_TO_TICKS(value) (value)
using BaseType_t = int;
constexpr int pdFALSE = 0, pdTRUE = 1;
constexpr unsigned portMAX_DELAY = 0xFFFFFFFFU;
struct StaticSemaphore_t { bool ready{}; };
using SemaphoreHandle_t = StaticSemaphore_t *;
using async_memcpy_handle_t = void *;
struct async_memcpy_event_t {};
using Callback = bool (*)(async_memcpy_handle_t, async_memcpy_event_t *, void *);
using esp_err_t = int;
constexpr int ESP_OK = 0;
constexpr unsigned MALLOC_CAP_SPIRAM=1, MALLOC_CAP_8BIT=2, MALLOC_CAP_INTERNAL=4;
static Callback pending_callback;
static void *pending_arg, *pending_dst, *pending_src;
static size_t pending_size;
static unsigned mode;
static bool saw_drain_wait;
static uint32_t timer;
static uint32_t micros() { return ++timer; }
static size_t heap_caps_get_free_size(unsigned) { return 1000000; }
template<class... Args> static void log_noop(Args &&...) {}
#define ESP_LOGW(...) log_noop(__VA_ARGS__)
#define ESP_LOGI(...) log_noop(__VA_ARGS__)

static SemaphoreHandle_t xSemaphoreCreateBinaryStatic(StaticSemaphore_t *s) {
  s->ready = false;
  return s;
}
static void xSemaphoreGiveFromISR(SemaphoreHandle_t s, BaseType_t *wake) {
  s->ready = true;
  *wake = pdTRUE;
}
static void complete_pending_dma() {
  std::memcpy(pending_dst, pending_src, pending_size);
  auto cb = pending_callback;
  pending_callback = nullptr;
  cb(reinterpret_cast<void *>(1), nullptr, pending_arg);
}
static int xSemaphoreTake(SemaphoreHandle_t s, unsigned ticks) {
  if (mode == 0 && pending_callback) complete_pending_dma();
  if (mode == 1 && ticks == portMAX_DELAY && pending_callback) {
    saw_drain_wait = true;
    complete_pending_dma();
  }
  return s->ready ? pdTRUE : pdFALSE;
}
static esp_err_t esp_async_memcpy(async_memcpy_handle_t, void *dst, void *src,
                                 size_t size, Callback cb, void *arg) {
  if (mode == 2) return 1;
  pending_callback=cb;
  pending_arg=arg;
  pending_dst=dst;
  pending_src=src;
  pending_size=size;
  return ESP_OK;
}

namespace esphome::mipi_rgb {
class MipiRgb {
 public:
  unsigned char a[64]{}, b[64]{};
  bool get_native_frame_buffers(void **first, void **second) {
    *first=a; *second=b; return true;
  }
  bool present_native_frame(void *, int, int, int, int) { return true; }
  bool wait_native_frame_complete() { return true; }
};
}
static esphome::mipi_rgb::MipiRgb display;
static unsigned char cached[64]{};

namespace esphome::lvgl {
class LvglComponent {
 public:
  bool qa_frame_cache_valid_{true}, qa_frame_cache_hold_{true};
  bool last_presented_frame_complete_{true};
  void *qa_frame_cache_{cached};
  size_t qa_frame_cache_bytes_{sizeof(cached)};
  void *last_presented_frame_{display.a};
  void *disp_{&display}, *qa_dma_handle_{reinterpret_cast<void *>(1)};
  std::vector<esphome::mipi_rgb::MipiRgb *> displays_{&display};
  int get_width() const { return 8; }
  int get_height() const { return 8; }
  bool qa_present_cached_native_frame_dma();
};
// PRODUCTION_CONTEXT_AND_METHOD
}

int main(int argc, char **argv) {
  assert(argc == 2);
  mode = std::string(argv[1]) == "late" ? 1 :
      (std::string(argv[1]) == "reject" ? 2 : 0);
  esphome::lvgl::LvglComponent component;
  const bool result = component.qa_present_cached_native_frame_dma();
  if (mode == 0) {
    assert(result && !pending_callback);
    std::puts("QA_DMA_ON_TIME=PASS");
  } else if (mode == 2) {
    assert(!result && !pending_callback);
    std::puts("QA_DMA_REJECTED_SUBMISSION=PASS");
  } else {
    if (pending_callback) {
      std::puts("QA_DMA_TIMEOUT_RETURNED_WITH_PENDING_CALLBACK=YES");
      std::fflush(stdout);
      pending_callback(reinterpret_cast<void *>(1), nullptr, pending_arg);
      return 2;
    }
    assert(!result && saw_drain_wait);
    std::puts("QA_DMA_TIMEOUT_DRAINED=PASS");
  }
}
